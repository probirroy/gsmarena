---
import BaseLayout from '../layouts/BaseLayout.astro';
import DeviceArt from '../components/DeviceArt.astro';
import StoryArt from '../components/StoryArt.astro';
import {
  phones,
  manufacturers,
  newsArticles,
  reviews,
  latestDevices,
  topFans,
  popularComparisons,
  featuredVideos,
  bottomBanner
} from '../data/catalog';

const findPhone = (slug: string) => phones.find((phone) => phone.slug === slug);
const shortName = (name: string) => name.replace(/^(Samsung|Apple|Google|OnePlus|Xiaomi|Vivo|Honor|Oppo|Realme|Nothing)\s+/i, '');

const heroReview = reviews[0];
const sideReview = reviews[1];
const heroDevice = { name: 'Vivo X500 Pro Max', slug: 'vivo-x500-pro-max', manufacturer: 'vivo' };
const sideArticle = newsArticles[5];
const tickerStories = newsArticles.slice(2, 5);

const newsItems = newsArticles.slice(0, 6);
const trendingStories = newsArticles.slice(6, 10);

const dailySlugs = [
  'iphone-16-pro-max',
  'samsung-galaxy-s25-ultra',
  'oneplus-13',
  'xiaomi-15-ultra',
  'google-pixel-9-pro',
  'vivo-x200-pro',
  'samsung-galaxy-s25',
  'nothing-phone-3',
  'xiaomi-15-pro',
  'honor-magic7-pro'
];

const dailyTop = dailySlugs
  .map((slug, index) => ({ rank: index + 1, phone: findPhone(slug) }))
  .filter((item): item is { rank: number; phone: NonNullable<ReturnType<typeof findPhone>> } => Boolean(item.phone));

const fanRows = topFans.map((fan) => ({
  ...fan,
  phone: phones.find((phone) => `/phones/${phone.slug}` === fan.href)
}));

const comparisonCards = popularComparisons.slice(0, 4).map((comparison) => {
  const slugs = comparison.href.split('phones=')[1]?.split(',') ?? [];
  return {
    ...comparison,
    a: findPhone(slugs[0] ?? ''),
    b: findPhone(slugs[1] ?? '')
  };
});

const reviewDevices: Record<string, { name: string; slug: string; manufacturer: string }> = {
  'galaxy-tab-s10-ultra-review': { name: 'Galaxy Tab S10 Ultra', slug: 'galaxy-tab-s10-ultra', manufacturer: 'samsung' },
  'samsung-galaxy-s25-ultra-review': { name: 'Samsung Galaxy S25 Ultra', slug: 'samsung-galaxy-s25-ultra', manufacturer: 'samsung' },
  'google-pixel-9-pro-review': { name: 'Google Pixel 9 Pro', slug: 'google-pixel-9-pro', manufacturer: 'google' },
  'oneplus-12-review': { name: 'OnePlus 12', slug: 'oneplus-12', manufacturer: 'oneplus' }
};

const sidebarReviews = reviews.slice(1, 4);

const priceValue = (price: string) => Number(price.replace(/[^0-9]/g, ''));
const androidCount = phones.filter((phone) => phone.os.includes('Android')).length;
const iosCount = phones.filter((phone) => phone.os.includes('iOS')).length;
const under700 = phones.filter((phone) => priceValue(phone.price) < 700).length;
const midRange = phones.filter((phone) => priceValue(phone.price) >= 700 && priceValue(phone.price) <= 999).length;
const flagship = phones.filter((phone) => priceValue(phone.price) >= 1000).length;

const quickFilters = [
  { label: 'Android', count: androidCount, href: '/phones?os=android' },
  { label: 'iOS', count: iosCount, href: '/phones?os=ios' },
  { label: 'Under $700', count: under700, href: '/phones?price=under-700' },
  { label: '$700–$999', count: midRange, href: '/phones?price=700-999' },
  { label: '$1,000+', count: flagship, href: '/phones?price=1000+' },
  { label: 'Just released', count: phones.filter((phone) => phone.status === 'Released').length, href: '/phones?status=released' }
];

const finderPhones = [...phones]
  .sort((a, b) => a.name.localeCompare(b.name))
  .map((phone) => ({
    slug: phone.slug,
    name: phone.name,
    manufacturer: phone.manufacturer,
    manufacturerName: manufacturers.find((brand) => brand.slug === phone.manufacturer)?.name ?? phone.manufacturer
  }));

const deviceForReview = (slug: string) => reviewDevices[slug];
---

<BaseLayout
  title="TechAtlas — phone reviews, specs, news and comparisons"
  description="A clear, independent guide to phones: specifications, reviews, rankings, comparisons and the latest mobile technology news."
>
  <div class="home-page-v2">
    <div class="home-grid">
      <aside class="left-rail" aria-label="Phone discovery tools">
        <section class="rail-panel finder-panel" aria-labelledby="finder-title">
          <header class="panel-head">
            <h2 id="finder-title">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                <rect x="5" y="2.5" width="14" height="19" rx="2.5"></rect>
                <path d="M10 18.5h4"></path>
              </svg>
              Phone finder
            </h2>
            <span class="head-count">{phones.length} devices</span>
          </header>
          <div class="finder-body">
            <form id="phone-finder" action="/phones" method="get" data-finder>
              <div class="finder-step">
                <label for="finder-brand"><span>01</span> Brand</label>
                <select id="finder-brand" name="brand">
                  <option value="">All brands</option>
                  {manufacturers.map((brand) => <option value={brand.slug}>{brand.name}</option>)}
                </select>
              </div>
              <div class="finder-step">
                <label for="finder-model"><span>02</span> Model</label>
                <select id="finder-model" name="model">
                  <option value="">All models</option>
                  {finderPhones.map((phone) => (
                    <option value={phone.slug} data-brand={phone.manufacturer}>{phone.name}</option>
                  ))}
                </select>
              </div>
              <button class="finder-submit" type="submit">
                Find my phone
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                  <path d="M5 12h14"></path><path d="m14 7 5 5-5 5"></path>
                </svg>
              </button>
            </form>
            <p class="finder-hint">Or <a href="/phones">browse the full directory</a></p>
          </div>
        </section>

        <section class="rail-panel devices-panel" aria-labelledby="latest-devices-title">
          <header class="panel-head">
            <h2 id="latest-devices-title">Latest devices</h2>
            <a href="/phones">All phones <span aria-hidden="true">→</span></a>
          </header>
          <div class="mini-device-grid">
            {latestDevices.slice(0, 9).map((device) => (
              <a class="mini-device" href={`/phones/${device.slug}`} title={`${device.name} — ${device.brand}`}>
                <span class="mini-device-art">
                  <DeviceArt name={device.name} slug={device.slug} manufacturer={device.brand.toLowerCase()} size="xs" width={26} />
                </span>
                <span class="mini-device-name">{shortName(device.name)}</span>
              </a>
            ))}
          </div>
          <a class="panel-footer-link" href="/phones">
            Browse all {phones.length} phones
            <span aria-hidden="true">→</span>
          </a>
        </section>

        <section class="side-promo" aria-labelledby="promo-title">
          <span class="promo-eyebrow">Decision helper</span>
          <h2 id="promo-title">Two phones. One clear choice.</h2>
          <p>Put the specs that matter side by side and see exactly where they differ.</p>
          <a href="/compare">
            Start a comparison
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
              <path d="M5 12h14"></path><path d="m14 7 5 5-5 5"></path>
            </svg>
          </a>
          <span class="promo-ghost" aria-hidden="true">VS</span>
        </section>
      </aside>

      <div class="center-column">
        <section class="spotlight" aria-label="Featured stories">
          <a class="hero-card" href={`/reviews/${heroReview.slug}`}>
            <span class="hero-art">
              <StoryArt title={heroReview.title} category="Review" variant="hero" device={heroDevice} />
            </span>
            <span class="hero-shade" aria-hidden="true"></span>
            <span class="hero-topline">
              <span class="live-badge"><i aria-hidden="true"></i> Review of the week</span>
              <span class="hero-date">Updated 28 Oct</span>
            </span>
            <span class="hero-copy">
              <span class="hero-kicker">The long read</span>
              <strong class="hero-title">{heroReview.title}</strong>
              <span class="hero-excerpt">{heroReview.excerpt}</span>
              <span class="hero-bottom-row">
                <span class="hero-read-link">Read the verdict <span aria-hidden="true">→</span></span>
                <span class="hero-meta">By {heroReview.author} · 12 min read</span>
              </span>
            </span>
            <span class="hero-score" style={`--score:${heroReview.score}`}>
              <strong>{heroReview.score}</strong>
              <small>/10</small>
            </span>
          </a>

          <div class="hero-side-stack">
            <a class="side-feature" href={`/reviews/${sideReview.slug}`}>
              <span class="side-art">
                <StoryArt title={sideReview.title} category="Review" variant="wide" device={deviceForReview(sideReview.slug)} />
              </span>
              <span class="side-shade" aria-hidden="true"></span>
              <span class="side-copy">
                <span class="side-eyebrow">Review · {sideReview.score}/10</span>
                <strong>{sideReview.title}</strong>
                <span class="side-arrow" aria-hidden="true">↗</span>
              </span>
            </a>

            <a class="side-feature" href={`/news/${sideArticle.slug}`}>
              <span class="side-art">
                <StoryArt
                  title={sideArticle.title}
                  category={sideArticle.category}
                  variant="wide"
                  device={{ name: 'Huawei tri-fold concept', slug: 'huawei-trifold', manufacturer: 'huawei' }}
                />
              </span>
              <span class="side-shade" aria-hidden="true"></span>
              <span class="side-copy">
                <span class="side-eyebrow">{sideArticle.category} · {sideArticle.publishedAt}</span>
                <strong>{sideArticle.title}</strong>
                <span class="side-arrow" aria-hidden="true">↗</span>
              </span>
            </a>
          </div>
        </section>

        <div class="ticker-strip" aria-label="Today's briefing">
          <span class="ticker-label"><i aria-hidden="true"></i> Today</span>
          <div class="ticker-items">
            {tickerStories.map((story) => (
              <a href={`/news/${story.slug}`}>{story.title}<span aria-hidden="true">↗</span></a>
            ))}
          </div>
        </div>

        <section class="section-panel news-panel" aria-labelledby="news-title">
          <header class="panel-head">
            <h2 id="news-title">Latest news</h2>
            <a href="/news">All stories <span aria-hidden="true">→</span></a>
          </header>
          <div class="news-tabs" role="tablist" aria-label="Filter news">
            <button type="button" class="news-tab is-active" data-news-tab="all" role="tab" aria-selected="true">All</button>
            <button type="button" class="news-tab" data-news-tab="Launch" role="tab" aria-selected="false">Launches</button>
            <button type="button" class="news-tab" data-news-tab="Rumor" role="tab" aria-selected="false">Rumors</button>
            <button type="button" class="news-tab" data-news-tab="Software" role="tab" aria-selected="false">Software</button>
            <button type="button" class="news-tab" data-news-tab="Comparison" role="tab" aria-selected="false">Comparisons</button>
            <span class="news-tab-spacer"></span>
            <span class="news-filter-count" data-news-count>{newsItems.length} stories</span>
          </div>
          <div class="news-list" data-news-list>
            {newsItems.map((article) => (
              <a class="news-row" href={`/news/${article.slug}`} data-news-category={article.category}>
                <span class="news-thumb">
                  <StoryArt title={article.title} category={article.category} variant="thumb" />
                </span>
                <span class="news-copy">
                  <span class="news-meta"><span class="news-category">{article.category}</span><i aria-hidden="true">·</i>{article.publishedAt}</span>
                  <strong class="news-title">{article.title}</strong>
                  <span class="news-excerpt">{article.excerpt}</span>
                  <span class="news-author">By {article.author}</span>
                </span>
                <span class="news-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
          <a class="panel-footer-link" href="/news">
            Read every story
            <span aria-hidden="true">→</span>
          </a>
        </section>
      </div>

      <aside class="right-rail" aria-label="Reviews and shortcuts">
        <section class="rail-panel reviews-panel" aria-labelledby="reviews-title">
          <header class="panel-head">
            <h2 id="reviews-title">Latest reviews</h2>
            <a href="/reviews">All <span aria-hidden="true">→</span></a>
          </header>
          <div class="review-list">
            {sidebarReviews.map((review) => {
              const device = deviceForReview(review.slug);
              return (
                <a class="review-row" href={`/reviews/${review.slug}`}>
                  <span class="review-thumb">
                    <StoryArt title={review.title} category="Review" variant="thumb" device={device} />
                  </span>
                  <span class="review-copy">
                    <span class="review-eyebrow">Review</span>
                    <strong>{review.title}</strong>
                    <small>By {review.author}</small>
                  </span>
                  <span class="review-score" style={`--score:${review.score}`}>
                    <strong>{review.score}</strong>
                  </span>
                </a>
              );
            })}
          </div>
          <a class="panel-footer-link" href="/reviews">
            More reviews
            <span aria-hidden="true">→</span>
          </a>
        </section>

        <section class="rail-panel filters-panel" aria-labelledby="filters-title">
          <header class="panel-head">
            <h2 id="filters-title">Quick filters</h2>
            <span class="head-count">Jump in</span>
          </header>
          <div class="filter-chips">
            {quickFilters.map((filter) => (
              <a class="filter-chip" href={filter.href}>
                <span>{filter.label}</span>
                <small>{filter.count}</small>
              </a>
            ))}
          </div>
          <a class="panel-footer-link" href="/phones">
            Open full finder
            <span aria-hidden="true">→</span>
          </a>
        </section>

        <section class="rail-panel trending-panel" aria-labelledby="trending-title">
          <header class="panel-head">
            <h2 id="trending-title">Trending now</h2>
            <span class="pulse-dot" aria-hidden="true"></span>
          </header>
          <div class="trending-list">
            {trendingStories.map((story, index) => (
              <a class="trending-row" href={`/news/${story.slug}`}>
                <span class="trending-rank">{String(index + 1).padStart(2, '0')}</span>
                <span class="trending-copy">
                  <strong>{story.title}</strong>
                  <small>{story.category} · {story.publishedAt}</small>
                </span>
                <span class="trending-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>

        <section class="brief-card" aria-labelledby="brief-title">
          <span class="brief-orbit brief-orbit--one" aria-hidden="true"></span>
          <span class="brief-orbit brief-orbit--two" aria-hidden="true"></span>
          <span class="brief-eyebrow">The weekly brief</span>
          <h2 id="brief-title">The five stories worth your time.</h2>
          <p>A sharp edit of launches, reviews and the industry moves that matter. Every Friday.</p>
          <form id="brief-form" class="brief-form">
            <label class="sr-only" for="brief-email">Email address</label>
            <input id="brief-email" type="email" name="email" placeholder="you@example.com" required />
            <button type="submit" aria-label="Subscribe to the weekly brief">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"></path><path d="m14 7 5 5-5 5"></path>
              </svg>
            </button>
          </form>
          <p class="brief-status" role="status" aria-live="polite" data-brief-status></p>
          <span class="brief-note">Demo signup · no email addresses are stored.</span>
        </section>
      </aside>
    </div>

    <section class="rankings-grid" aria-label="Phone rankings">
      <div class="section-panel ranking-panel">
        <header class="panel-head">
          <h2>Top 10 by daily interest</h2>
          <span class="head-note">Updated hourly</span>
        </header>
        <ol class="ranking-list">
          {dailyTop.map((item) => (
            <li>
              <a class="ranking-row" href={`/phones/${item.phone.slug}`}>
                <span class:list={['ranking-rank', { 'ranking-rank--top': item.rank <= 3 }]}>{String(item.rank).padStart(2, '0')}</span>
                <span class="ranking-thumb">
                  <DeviceArt name={item.phone.name} slug={item.phone.slug} manufacturer={item.phone.manufacturer} size="xs" width={14} />
                </span>
                <span class="ranking-copy">
                  <strong>{item.phone.name}</strong>
                  <small>{item.phone.display} · {item.phone.price}</small>
                </span>
                <span class="ranking-rating">★ {item.phone.rating}</span>
                <span class="ranking-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ol>
        <a class="panel-footer-link" href="/phones">See the full phone chart <span aria-hidden="true">→</span></a>
      </div>

      <div class="section-panel fans-panel">
        <header class="panel-head">
          <h2>Top 10 by fans</h2>
          <span class="head-note">Community pulse</span>
        </header>
        <ol class="fans-list">
          {fanRows.map((fan) => (
            <li>
              <a class="fan-row" href={fan.href}>
                <span class:list={['fan-rank', { 'fan-rank--top': fan.rank <= 3 }]}>{String(fan.rank).padStart(2, '0')}</span>
                <span class="fan-copy">
                  <strong>{fan.name}</strong>
                  <span class="fan-meter"><i style={`width:${Math.max(18, 100 - (fan.rank - 1) * 8)}%`}></i></span>
                </span>
                <span class="fan-score">{100 - (fan.rank - 1) * 4}<small>%</small></span>
              </a>
            </li>
          ))}
        </ol>
        <a class="panel-footer-link" href="/phones">Explore community favorites <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="lower-grid" aria-label="Comparisons and videos">
      <div class="section-panel comparisons-panel">
        <header class="panel-head">
          <h2>Popular comparisons</h2>
          <a href="/compare">Make your own <span aria-hidden="true">→</span></a>
        </header>
        <div class="comparison-grid">
          {comparisonCards.map((comparison) => (
            <a class="comparison-card" href={comparison.href}>
              <span class="comparison-devices">
                {comparison.a && (
                  <span class="comparison-device">
                    <DeviceArt name={comparison.a.name} slug={comparison.a.slug} manufacturer={comparison.a.manufacturer} size="xs" width={24} />
                    <small>{shortName(comparison.a.name)}</small>
                  </span>
                )}
                <span class="comparison-vs">VS</span>
                {comparison.b && (
                  <span class="comparison-device">
                    <DeviceArt name={comparison.b.name} slug={comparison.b.slug} manufacturer={comparison.b.manufacturer} size="xs" width={24} />
                    <small>{shortName(comparison.b.name)}</small>
                  </span>
                )}
              </span>
              <span class="comparison-title">{comparison.title}</span>
              <span class="comparison-link">Compare side by side <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>

      <div class="section-panel videos-panel">
        <header class="panel-head">
          <h2>Featured videos</h2>
          <a href="/videos">Watch all <span aria-hidden="true">→</span></a>
        </header>
        <div class="video-grid">
          {featuredVideos.map((video, index) => (
            <a class="video-card" href={video.href}>
              <span class="video-art">
                <StoryArt
                  title={video.title}
                  category={video.category}
                  variant="video"
                  device={index === 0 ? heroDevice : index === 1 ? { name: 'Samsung Galaxy S25 Ultra', slug: 'samsung-galaxy-s25-ultra', manufacturer: 'samsung' } : undefined}
                />
                <span class="play-button" aria-hidden="true"><span></span></span>
                <span class="video-duration">{video.duration}</span>
              </span>
              <span class="video-copy">
                <span class="video-category">{video.category}</span>
                <strong>{video.title}</strong>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="bottom-banner" aria-labelledby="banner-title">
      <span class="banner-glow" aria-hidden="true"></span>
      <span class="banner-grid" aria-hidden="true"></span>
      <div class="banner-copy">
        <span class="banner-eyebrow">{bottomBanner.eyebrow}</span>
        <h2 id="banner-title">{bottomBanner.title}</h2>
        <p>{bottomBanner.summary}</p>
        <div class="banner-actions">
          <a class="banner-primary" href={bottomBanner.href}>
            Read the guide
            <span aria-hidden="true">→</span>
          </a>
          <a class="banner-secondary" href="/compare">Compare the shortlist</a>
        </div>
      </div>
      <div class="banner-devices" aria-hidden="true">
        <span class="banner-phone banner-phone--one">
          <DeviceArt name="Samsung Galaxy S25 Ultra" slug="samsung-galaxy-s25-ultra" manufacturer="samsung" size="md" />
        </span>
        <span class="banner-phone banner-phone--two">
          <DeviceArt name="iPhone 16 Pro Max" slug="iphone-16-pro-max" manufacturer="apple" size="lg" />
        </span>
        <span class="banner-phone banner-phone--three">
          <DeviceArt name="OnePlus 13" slug="oneplus-13" manufacturer="oneplus" size="md" />
        </span>
      </div>
      <span class="banner-word" aria-hidden="true">ATLAS</span>
    </section>
  </div>

  <script>
    const finder = document.querySelector<HTMLFormElement>('[data-finder]');
    const brandSelect = document.querySelector<HTMLSelectElement>('#finder-brand');
    const modelSelect = document.querySelector<HTMLSelectElement>('#finder-model');
    const modelOptions = modelSelect ? [...modelSelect.querySelectorAll<HTMLOptionElement>('option[data-brand]')] : [];

    function filterModels() {
      if (!brandSelect || !modelSelect) return;
      const brand = brandSelect.value;
      modelOptions.forEach((option) => {
        option.hidden = Boolean(brand) && option.dataset.brand !== brand;
      });
      const selected = modelSelect.selectedOptions[0];
      if (selected && selected.hidden) modelSelect.value = '';
    }

    brandSelect?.addEventListener('change', filterModels);

    finder?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!brandSelect || !modelSelect) return;
      const slug = modelSelect.value;
      if (slug) {
        window.location.href = `/phones/${slug}`;
        return;
      }
      const params = new URLSearchParams();
      if (brandSelect.value) params.set('brand', brandSelect.value);
      window.location.href = `/phones${params.toString() ? `?${params}` : ''}`;
    });

    const newsTabs = [...document.querySelectorAll<HTMLButtonElement>('[data-news-tab]')];
    const newsRows = [...document.querySelectorAll<HTMLElement>('[data-news-category]')];
    const newsCount = document.querySelector<HTMLElement>('[data-news-count]');

    newsTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        newsTabs.forEach((item) => {
          item.classList.toggle('is-active', item === tab);
          item.setAttribute('aria-selected', String(item === tab));
        });
        const target = tab.dataset.newsTab ?? 'all';
        let visible = 0;
        newsRows.forEach((row) => {
          const match = target === 'all' || row.dataset.newsCategory === target;
          row.hidden = !match;
          if (match) visible += 1;
        });
        if (newsCount) newsCount.textContent = `${visible} ${visible === 1 ? 'story' : 'stories'}`;
      });
    });

    const briefForm = document.querySelector<HTMLFormElement>('#brief-form');
    const briefStatus = document.querySelector<HTMLElement>('[data-brief-status]');
    briefForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!briefStatus) return;
      const email = briefForm.querySelector<HTMLInputElement>('input[type="email"]');
      if (!email?.value || !email.checkValidity()) {
        briefStatus.textContent = 'Enter a valid email address.';
        briefStatus.classList.add('is-error');
        return;
      }
      briefStatus.classList.remove('is-error');
      briefStatus.textContent = 'You are on the preview list — no email was stored.';
      briefForm.reset();
    });
  </script>

