---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Accounts | TechAtlas" description="Community account features are not enabled in this build.">
  <div class="page-shell">
    <div class="breadcrumbs">Home / Accounts</div>
    <article class="panel" style="max-width: 700px; margin: 3rem auto;">
      <span class="pill">In development</span>
      <h1>Community accounts are not enabled yet</h1>
      <p class="muted">Admin sign-in is available separately. User registration, favorites, and community reviews are not connected in this build.</p>
      <a href="/admin" class="primary-button">Open admin sign-in</a>
    </article>
  </div>
</BaseLayout>
