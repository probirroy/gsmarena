---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryArt from '../../components/StoryArt.astro';
import { getArticleBySlug, newsArticles } from '../../data/catalog';

export function getStaticPaths() {
  return newsArticles.map((article) => ({ params: { slug: article.slug } }));
}

const { slug } = Astro.params;
const article = getArticleBySlug(slug ?? '');
if (!article) {
  throw new Error('Article not found');
}

const index = newsArticles.findIndex((item) => item.slug === article.slug);
const previous = newsArticles[index - 1];
const next = newsArticles[index + 1];
const related = newsArticles.filter((item) => item.slug !== article.slug).slice(0, 4);
const readTime = Math.max(3, Math.round(article.excerpt.split(' ').length / 18));
const categoryParagraphs: Record<string, string[]> = {
  Launch: [
    'The launch gives the company another entry in a segment that is becoming more competitive by the month. The headline specification is only part of the story; the real question is how the package holds together once the first wave of reviews and retail offers arrives.',
    'Availability and regional pricing will matter as much as the hardware. Buyers should watch for confirmation of storage variants, warranty terms and carrier support before treating the announcement as a complete buying recommendation.'
  ],
  Rumor: [
    'As with any early report, the details should be treated as provisional. Supply chains frequently test several configurations before a final product is signed off, and certification listings do not always describe the version that reaches stores.',
    'The useful signal is not a single number or render — it is the direction of travel. If the claim is repeated by multiple credible sources, the picture becomes more reliable. Until then, keep it filed as an interesting possibility rather than a purchase plan.'
  ],
  Software: [
    'Software rollouts are rarely just about a new version number. The features that survive the update cycle are the ones that reduce friction: better notification handling, more predictable battery behavior, and security patches that arrive on a dependable schedule.',
    'Owners should check regional rollout schedules before updating, and back up important data as a routine precaution. Staged releases can take days or weeks to reach every device, even when the update has been announced globally.'
  ],
  Comparison: [
    'A comparison is most useful when it separates specification differences from the things people actually notice. Display brightness, camera consistency, charging speed and software support often matter more than a single benchmark result.',
    'The right choice depends on the trade-offs you are willing to live with. Our comparison tool keeps those differences side by side so the decision is based on the whole package rather than one headline feature.'
  ],
  Industry: [
    'The wider context matters here. Component supply, currency movements and regional demand can change the shape of a product lineup long before a phone is announced, often in ways that are invisible on a specification sheet.',
    'For buyers, the practical takeaway is to build in some flexibility. Prices and availability can shift quickly, and the best-value option today is not always the one that will make sense next quarter.'
  ],
  Wearable: [
    'Wearables are increasingly defined by the quality of their health features rather than the hardware alone. Accurate sensors, clear explanations and sensible privacy controls are what turn a stream of numbers into something usable.',
    'Anyone relying on a wearable for health insights should treat it as a helpful everyday tool, not a replacement for professional advice. Firmware updates and how they are validated matter as much as the launch presentation.'
  ]
};
const paragraphs = categoryParagraphs[article.category] ?? [
  'The story is part of a broader shift in how phones are designed, sold and supported. Each new release adds another data point, but the useful picture only emerges when specifications, software policy and real-world pricing are considered together.',
  'We will keep this page updated as more reliable information becomes available. For now, the details above are sample editorial content intended to demonstrate the article experience on TechAtlas.'
];
---

<BaseLayout title={`${article.title} | TechAtlas News`} description={article.excerpt}>
  <div class="article-page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      <a href="/news">News</a><span aria-hidden="true">/</span>
      <span>{article.category}</span>
    </nav>

    <header class="article-head">
      <div class="article-head-copy">
        <span class="article-category">{article.category}</span>
        <h1>{article.title}</h1>
        <p class="article-dek">{article.excerpt}</p>
        <div class="byline-row">
          <span class="author-avatar" aria-hidden="true">{article.author.slice(0, 1)}</span>
          <div class="byline-copy">
            <strong>{article.author}</strong>
            <span>{article.publishedAt} · {readTime} min read</span>
          </div>
          <button class="share-button" type="button" data-share>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle>
              <path d="m8.6 10.5 6.8-4M8.6 13.5l6.8 4"></path>
            </svg>
            Share
          </button>
          <span class="share-status" role="status" aria-live="polite" data-share-status></span>
        </div>
      </div>
    </header>

    <div class="article-layout">
      <main class="article-main">
        <figure class="article-hero">
          <StoryArt title={article.title} category={article.category} variant="wide" />
          <figcaption>Original TechAtlas illustration · Sample story imagery</figcaption>
        </figure>

        <article class="article-body">
          <p class="article-lede">{article.excerpt}</p>
          <p>{paragraphs[0]}</p>
          <h2>What it means for buyers</h2>
          <p>{paragraphs[1]}</p>

          <aside class="article-note">
            <span class="note-label">The short version</span>
            <p>{article.category === 'Rumor'
              ? 'Treat the claim as provisional until a second credible source or final retail listing appears.'
              : 'The announcement is a useful signal, but regional availability and final pricing are the details to watch next.'}</p>
          </aside>

          <p>The wider mobile market is moving quickly, and the details that matter are often buried beneath the headline specification. Our approach is to keep the context visible: what is confirmed, what is still uncertain, and what it means for someone choosing a phone this year.</p>

          <h2>What happens next</h2>
          <p>We will update this story as official details, pricing and independent testing become available. In the meantime, the phone directory and comparison tool are the best places to weigh this against the alternatives already on the market.</p>

          <div class="article-actions">
            <a class="action-primary" href="/phones">Browse the phone directory <span aria-hidden="true">→</span></a>
            <a class="action-secondary" href="/compare">Compare two phones</a>
          </div>

          <footer class="article-tags">
            <span>Filed under</span>
            <a href="/news">{article.category}</a>
            <a href="/news">Mobile industry</a>
            <a href="/news">TechAtlas news</a>
          </footer>
        </article>

        <nav class="article-nav" aria-label="More stories">
          {previous ? (
            <a class="article-nav-link" href={`/news/${previous.slug}`}>
              <span>← Previous story</span>
              <strong>{previous.title}</strong>
            </a>
          ) : <span></span>}
          {next ? (
            <a class="article-nav-link article-nav-link--next" href={`/news/${next.slug}`}>
              <span>Next story →</span>
              <strong>{next.title}</strong>
            </a>
          ) : <span></span>}
        </nav>
      </main>

      <aside class="article-side" aria-label="Related coverage">
        <section class="side-panel">
          <header class="panel-head">
            <h2>Story briefing</h2>
          </header>
          <dl class="briefing-list">
            <div><dt>Category</dt><dd>{article.category}</dd></div>
            <div><dt>Published</dt><dd>{article.publishedAt}</dd></div>
            <div><dt>Author</dt><dd>{article.author}</dd></div>
            <div><dt>Reading time</dt><dd>{readTime} minutes</dd></div>
          </dl>
        </section>

        <section class="side-panel">
          <header class="panel-head">
            <h2>More from the desk</h2>
            <a href="/news">All news <span aria-hidden="true">→</span></a>
          </header>
          <div class="side-stories">
            {related.slice(0, 3).map((story) => (
              <a class="side-story" href={`/news/${story.slug}`}>
                <span class="side-thumb">
                  <StoryArt title={story.title} category={story.category} variant="thumb" />
                </span>
                <span class="side-story-copy">
                  <span>{story.category}</span>
                  <strong>{story.title}</strong>
                  <small>{story.publishedAt}</small>
                </span>
              </a>
            ))}
          </div>
        </section>

        <section class="side-cta">
          <span class="side-cta-eyebrow">Stay sharp</span>
          <h2>One email. Five stories. Every Friday.</h2>
          <p>The weekly brief keeps the useful signal and leaves the noise behind.</p>
          <a href="/news#newsletter-form">Join the preview <span aria-hidden="true">→</span></a>
        </section>
      </aside>
    </div>

    <section class="related-section" aria-labelledby="related-title">
      <header class="related-head">
        <div>
          <span class="eyebrow">Keep reading</span>
          <h2 id="related-title">Related coverage</h2>
        </div>
        <a href="/news">See all news <span aria-hidden="true">→</span></a>
      </header>
      <div class="related-grid">
        {related.map((story) => (
          <a class="related-card" href={`/news/${story.slug}`}>
            <span class="related-art">
              <StoryArt title={story.title} category={story.category} variant="card" />
            </span>
            <span class="related-copy">
              <span class="related-meta">{story.category} · {story.publishedAt}</span>
              <strong>{story.title}</strong>
              <span>{story.excerpt}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <p class="catalog-notice">Sample editorial content. This story is illustrative and not a live news report.</p>
  </div>

  <script>
    const shareButton = document.querySelector<HTMLButtonElement>('[data-share]');
    const shareStatus = document.querySelector<HTMLElement>('[data-share-status]');

    shareButton?.addEventListener('click', async () => {
      const url = window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        if (shareStatus) shareStatus.textContent = 'Link copied';
      } catch {
        if (shareStatus) shareStatus.textContent = 'Copy the URL from your address bar';
      }
      window.setTimeout(() => {
        if (shareStatus) shareStatus.textContent = '';
      }, 2800);
    });
  </script>

  <style>
    :global(body) {
      background: #eef1f4;
      font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, Arial, sans-serif;
    }

    .article-page {
      --ink: #1b212a;
      --line: #dbe0e7;
      --accent: #e9542d;
      width: 100%;
      max-width: 1180px;
      margin: 0 auto;
      padding: 16px 18px 0;
      color: var(--ink);
    }

    .crumbs {
      display: flex;
      align-items: center;
      gap: 7px;
      margin-bottom: 14px;
      color: #8a94a2;
      font-size: 9px;
      font-weight: 600;
    }

    .crumbs a {
      color: #586575;
      text-decoration: none;
    }

    .crumbs a:hover {
      color: var(--accent);
    }

    .article-head {
      max-width: 900px;
      margin: 0 auto 20px;
      padding: 2px 2px 0;
    }

    .article-category {
      display: inline-flex;
      align-items: center;
      padding: 4px 7px;
      border: 1px solid #f0c1b3;
      border-radius: 3px;
      background: #fff3ee;
      color: #c04928;
      font-size: 7.5px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .article-head h1 {
      max-width: 22ch;
      margin: 10px 0 9px;
      color: #161d26;
      font-size: clamp(30px, 4.3vw, 48px);
      font-weight: 700;
      letter-spacing: -0.05em;
      line-height: 1.03;
    }

    .article-dek {
      max-width: 65ch;
      margin: 0 0 16px;
      color: #657080;
      font-size: 12px;
      line-height: 1.55;
    }

    .byline-row {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 9px;
      padding-top: 12px;
      border-top: 1px solid var(--line);
    }

    .author-avatar {
      display: grid;
      width: 31px;
      height: 31px;
      place-items: center;
      border-radius: 50%;
      background: linear-gradient(145deg, #2d3540, #171c23);
      color: #ff9b7b;
      font-size: 11px;
      font-weight: 800;
    }

    .byline-copy {
      display: grid;
      gap: 1px;
    }

    .byline-copy strong {
      color: #343e4a;
      font-size: 9.5px;
      font-weight: 700;
    }

    .byline-copy span {
      color: #98a2ae;
      font-size: 8px;
    }

    .share-button {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      margin-left: auto;
      padding: 6px 9px;
      border: 1px solid #dbe0e7;
      border-radius: 3px;
      background: #ffffff;
      color: #596575;
      font-size: 8px;
      font-weight: 700;
      letter-spacing: 0.03em;
      cursor: pointer;
      text-transform: uppercase;
    }

    .share-button:hover {
      border-color: #f0b7a5;
      color: #bd3e1c;
    }

    .share-status {
      color: #2d8a5b;
      font-size: 8px;
      font-weight: 600;
    }

    .article-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 18px;
      align-items: start;
    }

    .article-main {
      min-width: 0;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 9px;
      background: #ffffff;
      box-shadow: 0 1px 2px rgba(23, 32, 44, 0.035), 0 10px 24px rgba(23, 32, 44, 0.025);
    }

    .article-hero {
      margin: 0;
      border-bottom: 1px solid var(--line);
    }

    .article-hero :global(.story-art) {
      min-height: 310px;
    }

    .article-hero figcaption {
      padding: 7px 13px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      background: #232a33;
      color: #8b97a8;
      font-size: 7px;
      letter-spacing: 0.02em;
    }

    .article-body {
      padding: 24px 34px 28px;
    }

    .article-body > p {
      max-width: 68ch;
      margin: 0 0 15px;
      color: #3f4a58;
      font-size: 11.5px;
      line-height: 1.7;
    }

    .article-body > p.article-lede {
      color: #252f3a;
      font-size: 14px;
      font-weight: 500;
      line-height: 1.6;
    }

    .article-lede::first-letter {
      float: left;
      margin: 3px 7px 0 0;
      color: #d9441f;
      font-size: 40px;
      font-weight: 800;
      line-height: 0.78;
    }

    .article-body h2 {
      margin: 25px 0 9px;
      color: #1d2530;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.03em;
    }

    .article-note {
      margin: 22px 0;
      padding: 14px 16px;
      border-left: 3px solid #e9542d;
      border-radius: 0 5px 5px 0;
      background: #fff6f2;
    }

    .note-label {
      display: block;
      margin-bottom: 5px;
      color: #c04928;
      font-size: 7.5px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .article-note p {
      margin: 0;
      color: #4d5866;
      font-size: 10.5px;
      line-height: 1.6;
    }

    .article-actions {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 14px;
      margin: 25px 0 0;
      padding-top: 19px;
      border-top: 1px solid #edf0f3;
    }

    .action-primary {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 9px 12px;
      border-radius: 3px;
      background: linear-gradient(180deg, #f7623a, #d9441f);
      color: #ffffff;
      font-size: 8.5px;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-decoration: none;
      text-transform: uppercase;
      box-shadow: 0 4px 12px rgba(217, 68, 31, 0.22);
    }

    .action-primary:hover {
      filter: brightness(1.07);
      text-decoration: none;
    }

    .action-secondary {
      color: #586575;
      font-size: 8.5px;
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .action-secondary:hover {
      color: var(--accent);
    }

    .article-tags {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 19px;
      padding-top: 14px;
      border-top: 1px solid #edf0f3;
    }

    .article-tags span {
      margin-right: 3px;
      color: #98a2ae;
      font-size: 7.5px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .article-tags a {
      padding: 4px 7px;
      border: 1px solid #e4e8ed;
      border-radius: 3px;
      background: #fafbfc;
      color: #6c7887;
      font-size: 7.5px;
      font-weight: 600;
      text-decoration: none;
    }

    .article-tags a:hover {
      border-color: #f0b7a5;
      background: #fff3ee;
      color: #bd3e1c;
      text-decoration: none;
    }

    .article-nav {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      padding: 0 18px 18px;
    }

    .article-nav-link {
      display: grid;
      gap: 4px;
      padding: 12px;
      border: 1px solid #e4e8ed;
      border-radius: 5px;
      background: #fafbfc;
      color: inherit;
      text-decoration: none;
      transition: border-color 140ms, background 140ms;
    }

    .article-nav-link:hover {
      border-color: #f0b7a5;
      background: #fff8f5;
      text-decoration: none;
    }

    .article-nav-link span {
      color: #98a2ae;
      font-size: 7px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .article-nav-link strong {
      display: -webkit-box;
      overflow: hidden;
      color: #38424f;
      font-size: 9.5px;
      font-weight: 700;
      line-height: 1.35;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .article-nav-link--next {
      text-align: right;
    }

    .article-side {
      position: sticky;
      top: 112px;
      display: grid;
      gap: 12px;
      min-width: 0;
    }

    .side-panel {
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #ffffff;
      box-shadow: 0 1px 2px rgba(23, 32, 44, 0.035), 0 10px 24px rgba(23, 32, 44, 0.025);
    }

    .panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 9px;
      min-height: 35px;
      padding: 0 12px;
      border-bottom: 1px solid #343b45;
      background: linear-gradient(180deg, #3b434f 0%, #2d343e 100%);
      color: #ffffff;
    }

    .panel-head h2 {
      position: relative;
      margin: 0;
      padding-left: 9px;
      color: #ffffff;
      font-size: 9.5px;
      font-weight: 800;
      letter-spacing: 0.075em;
      text-transform: uppercase;
    }

    .panel-head h2::before {
      position: absolute;
      top: 50%;
      left: 0;
      width: 3px;
      height: 12px;
      border-radius: 999px;
      background: #ff7a50;
      content: '';
      transform: translateY(-50%);
    }

    .panel-head > a {
      color: #aeb9c8;
      font-size: 8px;
      font-weight: 700;
      text-decoration: none;
    }

    .panel-head > a:hover {
      color: #ffffff;
    }

    .briefing-list {
      margin: 0;
      padding: 5px 13px;
    }

    .briefing-list > div {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 9px;
      padding: 8px 0;
      border-bottom: 1px solid #edf0f3;
    }

    .briefing-list > div:last-child {
      border-bottom: 0;
    }

    .briefing-list dt {
      color: #98a2ae;
      font-size: 8px;
    }

    .briefing-list dd {
      margin: 0;
      color: #3a4553;
      font-size: 8.5px;
      font-weight: 700;
      text-align: right;
    }

    .side-stories {
      display: grid;
    }

    .side-story {
      display: grid;
      grid-template-columns: 64px minmax(0, 1fr);
      align-items: center;
      gap: 9px;
      padding: 9px 11px;
      border-bottom: 1px solid #edf0f3;
      color: inherit;
      text-decoration: none;
      transition: background 140ms;
    }

    .side-story:last-child {
      border-bottom: 0;
    }

    .side-story:hover {
      background: #f8f9fb;
      text-decoration: none;
    }

    .side-thumb {
      position: relative;
      width: 64px;
      height: 50px;
      overflow: hidden;
      border-radius: 4px;
      background: #202731;
    }

    .side-thumb :global(.story-art) {
      height: 100%;
      min-height: 100%;
    }

    .side-thumb :global(.story-badge) {
      display: none;
    }

    .side-story-copy {
      display: grid;
      gap: 2px;
      min-width: 0;
    }

    .side-story-copy > span {
      color: #d9441f;
      font-size: 6.5px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .side-story-copy strong {
      display: -webkit-box;
      overflow: hidden;
      color: #38424f;
      font-size: 9px;
      font-weight: 700;
      line-height: 1.3;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .side-story:hover .side-story-copy strong {
      color: #c63c1b;
    }

    .side-story-copy small {
      color: #a0a9b5;
      font-size: 7px;
    }

    .side-cta {
      position: relative;
      overflow: hidden;
      padding: 18px 16px;
      border-radius: 8px;
      background:
        radial-gradient(circle at 90% 0%, rgba(255, 122, 80, 0.34) 0%, transparent 38%),
        linear-gradient(145deg, #29313c 0%, #151a21 100%);
      color: #ffffff;
      box-shadow: 0 16px 34px rgba(20, 26, 34, 0.12);
    }

    .side-cta-eyebrow {
      display: block;
      margin-bottom: 6px;
      color: #ffad90;
      font-size: 8px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .side-cta h2 {
      max-width: 16ch;
      margin: 0 0 6px;
      color: #ffffff;
      font-size: 17px;
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.16;
    }

    .side-cta p {
      margin: 0 0 11px;
      color: #aab4c2;
      font-size: 9px;
      line-height: 1.5;
    }

    .side-cta a {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #ffb499;
      font-size: 8.5px;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-decoration: none;
      text-transform: uppercase;
    }

    .side-cta a:hover {
      color: #ffffff;
    }

    .related-section {
      margin-top: 20px;
