---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryArt from '../../components/StoryArt.astro';
import { featuredVideos, newsArticles } from '../../data/catalog';

const [lead, ...rest] = featuredVideos;
const watchNext = newsArticles.slice(9, 13);

const devices = [
  { name: 'Vivo X500 Pro Max', slug: 'vivo-x500-pro-max', manufacturer: 'vivo' },
  { name: 'Samsung Galaxy S25 Ultra', slug: 'samsung-galaxy-s25-ultra', manufacturer: 'samsung' },
  undefined,
  undefined
];
---

<BaseLayout title="Videos | TechAtlas" description="Video reviews, camera comparisons, buying guides and first looks from the TechAtlas editorial team.">
  <div class="videos-page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span><span>Videos</span>
    </nav>

    <header class="videos-head">
      <div>
        <span class="eyebrow">TechAtlas studio</span>
        <h1>Phones in motion.</h1>
        <p>Reviews, camera tests and buying advice, filmed with the details that matter.</p>
      </div>
      <div class="head-stat">
        <strong>{featuredVideos.length}</strong>
        <span>new films this week</span>
      </div>
    </header>

    <div class="video-layout">
      <main class="video-main">
        <a class="lead-video" href={lead.href}>
          <span class="lead-art">
            <StoryArt title={lead.title} category={lead.category} variant="hero" device={devices[0]} />
          </span>
          <span class="lead-shade" aria-hidden="true"></span>
          <span class="lead-play" aria-hidden="true"><span></span></span>
          <span class="lead-copy">
            <span class="lead-kicker">Featured film · {lead.duration}</span>
            <strong>{lead.title}</strong>
            <span class="lead-cta">Watch the story <span aria-hidden="true">→</span></span>
          </span>
        </a>

        <section class="video-section" aria-labelledby="latest-videos-title">
          <header class="section-head">
            <h2 id="latest-videos-title">Latest films</h2>
            <span>{rest.length + 1} videos</span>
          </header>
          <div class="video-cards">
            {featuredVideos.map((video, index) => (
              <a class="video-card" href={video.href}>
                <span class="video-art">
                  <StoryArt title={video.title} category={video.category} variant="video" device={devices[index]} />
                  <span class="play-button" aria-hidden="true"><span></span></span>
                  <span class="duration">{video.duration}</span>
                </span>
                <span class="video-copy">
                  <span class="video-category">{video.category}</span>
                  <strong>{video.title}</strong>
                  <small>TechAtlas video · {video.duration}</small>
                </span>
              </a>
            ))}
          </div>
        </section>
      </main>

      <aside class="video-side" aria-label="Watch next">
        <section class="side-panel">
          <header class="section-head">
            <h2>Watch next</h2>
            <span class="live-dot" aria-hidden="true"></span>
          </header>
          <div class="watch-list">
            {watchNext.map((story, index) => (
              <a class="watch-row" href={`/news/${story.slug}`}>
                <span class="watch-rank">{String(index + 1).padStart(2, '0')}</span>
                <span class="watch-copy">
                  <strong>{story.title}</strong>
                  <small>{story.category} · {story.publishedAt}</small>
                </span>
                <span class="watch-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>

        <section class="side-cta">
          <span class="side-cta-eyebrow">Have a tip?</span>
          <h2>See something we should cover?</h2>
          <p>Send us a launch tip, a camera sample or a correction. Our inbox is always open.</p>
          <a href="mailto:tips@techatlas.example">Send a tip <span aria-hidden="true">→</span></a>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  :global(body) {
    background: #eef1f4;
    font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, Arial, sans-serif;
  }

  .videos-page {
    --ink: #1b212a;
    --muted: #6e7887;
    --line: #dbe0e7;
    --accent: #e9542d;
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 16px 18px 0;
    color: var(--ink);
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 15px;
    color: #8a94a2;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .crumbs a {
    color: #586575;
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--accent);
  }

  .videos-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding: 4px 2px 18px;
  }

  .eyebrow {
    display: block;
    margin-bottom: 7px;
    color: var(--accent);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .videos-head h1 {
    margin: 0 0 5px;
    color: #171d25;
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .videos-head p {
    max-width: 48ch;
    margin: 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.55;
  }

  .head-stat {
    display: grid;
    justify-items: end;
    flex-shrink: 0;
    padding-bottom: 2px;
  }

  .head-stat strong {
    color: #1f2731;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .head-stat span {
    color: #98a2ae;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .video-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 16px;
    align-items: start;
  }

  .video-main {
    display: grid;
    gap: 16px;
    min-width: 0;
  }

  .lead-video {
    position: relative;
    display: block;
    overflow: hidden;
    min-height: 430px;
    border-radius: 10px;
    background: #151a21;
    color: #fff;
    isolation: isolate;
    text-decoration: none;
    box-shadow: 0 18px 42px rgba(20, 26, 34, 0.14);
  }

  .lead-video:hover {
    text-decoration: none;
  }

  .lead-art {
    position: absolute;
    inset: 0;
  }

  .lead-art :global(.story-art) {
    height: 100%;
    min-height: 100%;
  }

  .lead-art :global(.story-badge) {
    display: none;
  }

  .lead-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(4, 7, 12, 0.86) 0%, rgba(4, 7, 12, 0.12) 68%);
  }

  .lead-play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 64px;
    height: 64px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    background: rgba(7, 11, 17, 0.42);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.24);
    transform: translate(-50%, -50%);
    backdrop-filter: blur(8px);
    transition: background 160ms, transform 160ms;
  }

  .lead-play span {
    width: 0;
    height: 0;
    margin-left: 4px;
    border-top: 9px solid transparent;
    border-bottom: 9px solid transparent;
    border-left: 14px solid #fff;
  }

  .lead-video:hover .lead-play {
    background: rgba(233, 84, 45, 0.86);
    transform: translate(-50%, -50%) scale(1.07);
  }

  .lead-copy {
    position: absolute;
    right: 28px;
    bottom: 25px;
    left: 28px;
    z-index: 2;
    display: grid;
    gap: 7px;
    max-width: 560px;
  }

  .lead-kicker {
    color: #ffad90;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .lead-copy strong {
    max-width: 18ch;
    color: #fff;
    font-size: clamp(25px, 3.5vw, 37px);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.06;
  }

  .lead-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    margin-top: 5px;
    padding: 8px 11px;
    border-radius: 3px;
    background: linear-gradient(180deg, #f7623a, #d9441f);
    color: #fff;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .video-section {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: #fff;
    box-shadow: 0 10px 26px rgba(23, 32, 44, 0.035);
  }

  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 37px;
    padding: 0 12px;
    border-bottom: 1px solid #343b45;
    background: linear-gradient(180deg, #3b434f 0%, #2d343e 100%);
    color: #fff;
  }

  .section-head h2 {
    position: relative;
    margin: 0;
    padding-left: 9px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .section-head h2::before {
    position: absolute;
    top: 50%;
    left: 0;
    width: 3px;
    height: 12px;
    border-radius: 999px;
    background: #ff7a50;
    content: '';
    transform: translateY(-50%);
  }

  .section-head > span {
    color: #aeb9c8;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .video-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding: 12px;
  }

  .video-card {
    display: grid;
    gap: 7px;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .video-card:hover {
    text-decoration: none;
  }

  .video-art {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    background: #202731;
  }

  .video-art :global(.story-art) {
    height: 100%;
    min-height: 100%;
  }

  .video-art :global(.story-badge) {
    display: none;
  }

  .play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    background: rgba(7, 11, 17, 0.44);
    transform: translate(-50%, -50%);
    backdrop-filter: blur(6px);
    transition: background 150ms, transform 150ms;
  }

  .play-button span {
    width: 0;
    height: 0;
    margin-left: 3px;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-left: 9px solid #fff;
  }

  .video-card:hover .play-button {
    background: rgba(233, 84, 45, 0.86);
    transform: translate(-50%, -50%) scale(1.06);
  }

  .duration {
    position: absolute;
    right: 7px;
    bottom: 7px;
    padding: 2px 5px;
    border-radius: 2px;
    background: rgba(6, 10, 16, 0.72);
    color: #fff;
    font-size: 7px;
    font-weight: 700;
  }

  .video-copy {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .video-category {
    color: var(--accent);
    font-size: 7px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .video-copy strong {
    display: -webkit-box;
    overflow: hidden;
    color: #2b3541;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .video-card:hover .video-copy strong {
    color: #c63c1b;
  }

  .video-copy small {
    color: #99a3af;
    font-size: 7.5px;
  }

  .video-side {
    display: grid;
    gap: 13px;
    min-width: 0;
  }

  .side-panel {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: #fff;
    box-shadow: 0 10px 26px rgba(23, 32, 44, 0.035);
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ff7a50;
    box-shadow: 0 0 0 3px rgba(255, 122, 80, 0.18);
  }

  .watch-list {
    display: grid;
  }

  .watch-row {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) 10px;
    gap: 9px;
    align-items: start;
    padding: 10px 11px;
    border-bottom: 1px solid #edf0f3;
    color: inherit;
    text-decoration: none;
  }

  .watch-row:last-child {
    border-bottom: 0;
  }

  .watch-row:hover {
    background: #f8f9fb;
    text-decoration: none;
  }

  .watch-rank {
    color: #c2cad4;
    font-size: 10px;
    font-weight: 800;
  }

  .watch-copy {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .watch-copy strong {
    display: -webkit-box;
    overflow: hidden;
    color: #38424f;
    font-size: 9.5px;
    font-weight: 700;
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .watch-row:hover .watch-copy strong {
    color: #c63c1b;
  }

  .watch-copy small {
    color: #a0a9b5;
    font-size: 7px;
  }

  .watch-arrow {
    color: #bdc5cf;
    font-size: 9px;
  }

  .side-cta {
    position: relative;
    overflow: hidden;
    padding: 20px 18px;
    border-radius: 9px;
    background:
      radial-gradient(circle at 90% 0%, rgba(255, 122, 80, 0.34) 0%, transparent 38%),
      linear-gradient(145deg, #29313c 0%, #151a21 100%);
    color: #fff;
    box-shadow: 0 16px 34px rgba(20, 26, 34, 0.12);
  }

  .side-cta-eyebrow {
    display: block;
    margin-bottom: 7px;
    color: #ffad90;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .side-cta h2 {
    max-width: 15ch;
    margin: 0 0 6px;
    color: #fff;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.16;
  }

  .side-cta p {
    margin: 0 0 12px;
    color: #aab4c2;
    font-size: 9.5px;
    line-height: 1.5;
  }

  .side-cta a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #ffb499;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .side-cta a:hover {
    color: #fff;
  }

  @media (max-width: 960px) {
    .video-layout {
      grid-template-columns: minmax(0, 1fr) 260px;
    }
  }

  @media (max-width: 780px) {
    .videos-page {
      padding: 12px 12px 0;
    }

    .video-layout {
      grid-template-columns: 1fr;
    }

    .video-side {
      grid-template-columns: 1fr 1fr;
    }

    .side-cta {
      min-height: 100%;
    }
  }

  @media (max-width: 560px) {
    .videos-head {
      align-items: flex-start;
    }

    .head-stat {
      display: none;
    }

    .lead-video {
      min-height: 340px;
    }

    .lead-copy {
      right: 18px;
      bottom: 18px;
      left: 18px;
    }

    .video-cards {
      grid-template-columns: 1fr;
    }

    .video-side {
      grid-template-columns: 1fr;
    }
  }
</style>
